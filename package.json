{
  "name": "@zakkster/lite-text-layout",
  "version": "1.4.0",
  "description": "Zero-GC bitmap font word wrapper. Computes line breaks, kerning-aware widths, and truncation/ellipsis flags into a Float32Array that feeds @zakkster/lite-bmfont's drawWrapped directly. Supports bmfont 1.x and 2.x.",
  "author": "Zahary Shinikchiev <shinikchiev@yahoo.com>",
  "license": "MIT",
  "type": "module",
  "main": "./TextLayout.js",
  "module": "./TextLayout.js",
  "types": "./TextLayout.d.ts",
  "exports": {
    ".": {
      "import": "./TextLayout.js",
      "node": "./TextLayout.js",
      "types": "./TextLayout.d.ts",
      "default": "./TextLayout.js"
    }
  },
  "files": [
    "TextLayout.js",
    "TextLayout.d.ts",
    "llms.txt",
    "README.md",
    "CHANGELOG.md",
    "LICENSE.txt"
  ],
  "keywords": [
    "bmfont",
    "bitmap-font",
    "text-layout",
    "word-wrap",
    "text-wrap",
    "line-break",
    "wrap",
    "ellipsis",
    "truncate",
    "kerning",
    "canvas",
    "canvas2d",
    "game-text",
    "hud",
    "zero-gc",
    "zero-alloc",
    "typed-array"
  ],
  "sideEffects": false,
  "homepage": "https://github.com/PeshoVurtoleta/lite-text-layout#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PeshoVurtoleta/lite-text-layout.git"
  },
  "bugs": {
    "url": "https://github.com/PeshoVurtoleta/lite-text-layout/issues",
    "email": "shinikchiev@yahoo.com"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/PeshoVurtoleta"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@zakkster/lite-bmfont": "^2.0.1",
    "@zakkster/lite-gc-profiler": "^1.15.0",
    "@zakkster/lite-leak": "^1.8.1"
  },
  "scripts": {
    "test": "node --test test/TextLayout.test.js test/TextLayout.boundary.test.js test/TextLayout.drift.test.js test/TextLayout.docsdrift.test.js test/TextLayout.snippets.test.js",
    "torture": "node --expose-gc test/torture.mjs",
    "verify": "npm run test && npm run torture",
    "prepublishOnly": "npm run verify"
  }
}
